#!/usr/bin/env node

import { exportXlsx, importXlsx } from './../flotiq-xlsx-migrate.js';

const helpText = `Flotiq Excel Migrator

Usage:
  flotiq-excel-migrator <command> [options]

Commands:
  export              Export content objects to an XLSX file
  import              Import content objects from an XLSX file

Required options:
  --api-key <value>   Flotiq API key
  --ctd-name <value>  Content type definition API name

Options:
  --file-path <path>      Export directory or XLSX file path for import
  --limit <number>        Limit number of processed content objects
  --batch-limit <number>  Batch size for import (1-100)
  --no-update-existing    Disable updating existing objects on import
  --no-save-file          Return export data without writing an XLSX file
  --no-log-results        Disable progress and summary logs
  -h, --help              Show this help message

Examples:
  flotiq-excel-migrator export --api-key abc --ctd-name product --file-path ./exports
  flotiq-excel-migrator import --api-key abc --ctd-name product --file-path ./products.xlsx
`;

const parseArgs = (argv) => {
	const options = {};

	for (let i = 0; i < argv.length; i++) {
		const arg = argv[i];

		if (arg === '--help' || arg === '-h') {
			options.help = true;
			continue;
		}

		if (arg.startsWith('--no-')) {
			const key = arg.slice(5).replace(/-([a-z])/g, (_, letter) => letter.toUpperCase());
			options[key] = false;
			continue;
		}

		if (arg.startsWith('--')) {
			const key = arg.slice(2).replace(/-([a-z])/g, (_, letter) => letter.toUpperCase());
			const nextArg = argv[i + 1];

			if (nextArg === undefined || nextArg.startsWith('-')) {
				options[key] = true;
				continue;
			}

			options[key] = nextArg;
			i++;
		}
	}

	if (options.limit !== undefined) {
		options.limit = Number.parseInt(options.limit, 10);
	}
	if (options.batchLimit !== undefined) {
		options.batchLimit = Number.parseInt(options.batchLimit, 10);
	}

	return options;
};

const printHelp = () => {
	console.log(helpText);
};

const run = async () => {
	const [, , ...argv] = process.argv;
	const command = argv[0];

	if (!command || command === 'help' || command === '--help' || command === '-h') {
		printHelp();
		return;
	}

	const options = parseArgs(argv.slice(1));
	if (options.help) {
		printHelp();
		return;
	}

	if (!options.apiKey || !options.ctdName) {
		console.error('Missing required options: --api-key and --ctd-name are required.');
		printHelp();
		process.exitCode = 1;
		return;
	}

	let result;
	if (command === 'export') {
		result = await exportXlsx(options);
	} else if (command === 'import') {
		result = await importXlsx(options);
	} else {
		console.error(`Unknown command: ${command}`);
		printHelp();
		process.exitCode = 1;
		return;
	}

	console.log(JSON.stringify(result, null, 2));
};

run().catch((error) => {
	console.error('Command failed:', error?.message || error);
	process.exitCode = 1;
});

#!/usr/bin/env node

import { importXlsx } from '../src/xls-import.js';
import { exportXlsx } from '../src/xls-export.js';
import yargs from 'yargs';
import { hideBin } from 'yargs/helpers';

const addSharedOptions = (builder) => builder
	.option('api-key', {
		type: 'string',
		demandOption: true,
		describe: 'Flotiq API key'
	})
	.option('ctd-name', {
		type: 'string',
		demandOption: true,
		describe: 'Content type definition API name'
	})
	.option('file-path', {
		type: 'string',
		describe: 'Export directory or XLSX file path for import'
	})
	.option('limit', {
		type: 'number',
		describe: 'Limit number of processed content objects'
	})
	.option('log-results', {
		type: 'boolean',
		default: true,
		describe: 'Enable progress and summary logs'
	});

const run = async () => {
	const argv = hideBin(process.argv);
	const cli = yargs(argv)
		.scriptName('flotiq-excel-migrator')
		.usage('Usage: $0 <command> [options]')
		.locale('en')
		.command(
			'export',
			'Export content objects to an XLSX file',
			(builder) => addSharedOptions(builder)
				.option('save-file', {
					type: 'boolean',
					default: true,
					describe: 'Write the XLSX output to a file'
				}),
			async (options) => {
				await exportXlsx(options);
			}
		)
		.command(
			'import',
			'Import content objects from an XLSX file',
			(builder) => addSharedOptions(builder)
				.option('batch-limit', {
					type: 'number',
					describe: 'Batch size for import (1-100)'
				})
				.option('update-existing', {
					type: 'boolean',
					default: true,
					describe: 'Update existing objects during import'
				}),
			async (options) => {
				await importXlsx(options);
			}
		)
		.strictCommands(true)
		.strictOptions(true)
		.help('help')
		.alias('help', 'h')
		.showHelpOnFail(true)
		.exitProcess(false)
		.fail((msg, err) => {
			if (msg) {
				console.error(msg);
			}
			if (err && !msg) {
				console.error(err?.message || err);
			}
			process.exitCode = 1;
		});

	if (argv.length === 0) {
		cli.showHelp('log');
		return;
	}

	await cli.parseAsync();
};

run().catch((error) => {
	console.error('Command failed:', error?.message || error);
	process.exitCode = 1;
});
